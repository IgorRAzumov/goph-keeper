# Локальная разработка (Postgres на 127.0.0.1:5432). Скопируйте в .env при необходимости.
GOPHKEEPER_ADDR=127.0.0.1:8080
GOPHKEEPER_JWT_SECRET=local-dev-jwt-secret
GOPHKEEPER_POSTGRES_DSN=postgres://postgres@127.0.0.1:5432/postgres?sslmode=disable
GOPHKEEPER_POSTGRES_MAX_OPEN_CONNS=10
GOPHKEEPER_ACCESS_TTL=15m
GOPHKEEPER_REFRESH_TTL=720h
